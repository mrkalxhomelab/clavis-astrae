{
  "manifest_version": 3,
  "name": "Clavis Astrae · Tabularium",
  "short_name": "Tabularium",
  "version": "1.2.0",
  "description": "Seal your Google Docs into astrological signs and your files into .age, and open them only on this computer.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tabularium",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "identity",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://docs.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "PASTE-YOUR-CLIENT-ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src https://www.googleapis.com https://docs.googleapis.com; frame-src 'self' blob:; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "116"
}
